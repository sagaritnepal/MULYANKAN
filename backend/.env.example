# Copy to .env and fill in.

# MySQL. Special characters in the password (@ $ : / etc.) must be
# percent-encoded or the URL won't parse correctly.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

PORT=3000

JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_TTL="30d"

# console -> logs the OTP code to the server console (dev/local use)
# sparrow -> sends real SMS via Sparrow SMS (https://sparrowsms.com)
OTP_PROVIDER="console"
SPARROW_SMS_TOKEN=""
SPARROW_SMS_FROM=""

OTP_TTL_SECONDS=300
OTP_CODE_LENGTH=6

# Email/password login's "forgot password" reset code. Only "console" is
# actually implemented right now (logs the code) — no SMTP/SendGrid
# credentials configured yet, so EMAIL_PROVIDER=smtp isn't functional.
EMAIL_PROVIDER="console"

# S3-compatible object storage (Cloudflare R2, Backblaze B2, MinIO for local dev)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="reconboard-photos"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000/reconboard-photos"

# Firebase Cloud Messaging. Leave FIREBASE_PROJECT_ID empty to fall back to a
# console-logging notification provider (dev/local use, no Firebase project needed).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

DEFAULT_WINDOW_SECONDS=300
ESCALATION_AT_SECONDS_LEFT=120
ESCALATION_MIN_QUOTES=3
